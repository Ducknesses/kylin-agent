# ============================================================
# MCP Server 环境变量模板
# 使用方法: cp .env.example .env 然后填写实际值
# .env 已被 .gitignore 排除，不会提交到 Git
# ============================================================

# HTTP 服务
MCP_HOST=127.0.0.1
MCP_PORT=8001

# Bearer Token 认证
# ⚠ 生产环境必须修改为强随机值（建议至少 32 位）
# 生成方式: openssl rand -hex 32
API_TOKEN=123456789

# 沙箱配置
COMMAND_TIMEOUT=30
MAX_OUTPUT_LINES=1000

# cgroups v2 资源限制（需 root 或 systemd Delegate=yes 委派）
CGROUP_ENABLED=false
CGROUP_CPU_QUOTA=50000
CGROUP_CPU_PERIOD=100000
CGROUP_MEMORY_MAX=268435456
CGROUP_MEMORY_SWAP_MAX=0
CGROUP_PIDS_MAX=64
CGROUP_IO_MAX=
CGROUP_CLEANUP_TIMEOUT=5

# 日志
LOG_FILE=/var/log/mcp-server.log
LOG_LEVEL=INFO