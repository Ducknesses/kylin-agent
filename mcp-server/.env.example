# ============================================================
# MCP Server 环境变量模板
# 使用方法: cp .env.example .env 然后填写实际值
# .env 已被 .gitignore 排除，不会提交到 Git
# ============================================================

# HTTP 服务
MCP_HOST=127.0.0.1
MCP_PORT=8001

# Bearer Token 认证
# ⚠ 生产环境必须修改为强随机值（建议至少 32 位）
# 生成方式: openssl rand -hex 32
API_TOKEN=123456789

# 沙箱配置
COMMAND_TIMEOUT=30
MAX_OUTPUT_LINES=1000

# 日志
LOG_FILE=/var/log/mcp-server.log
LOG_LEVEL=INFO