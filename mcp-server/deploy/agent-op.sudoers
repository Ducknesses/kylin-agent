# agent-op sudoers - MCP Server 服务管理权限白名单
# 安装路径: /etc/sudoers.d/agent-op
# 权限: chmod 440, chown root:root

# 注意：通配符 [a-zA-Z0-9@._-]* 限制了合法 systemd 单元名称，
# 避免操作 sshd/firewalld 等安全关键服务。
# 如果环境中服务名包含非标准字符，请根据实际情况调整正则表达式。
#
# mcp-server.service 以 agent-read 用户运行，service_mgr / sandbox 中的
# systemctl 变更操作（start/stop/restart/reload）通过 sudo -n 提权，
# 因此必须给 agent-read 授权；agent-op 保留给运维账号使用。
agent-read ALL=(root) NOPASSWD: /usr/bin/systemctl status [a-zA-Z0-9@._-]*, /usr/bin/systemctl start [a-zA-Z0-9@._-]*, /usr/bin/systemctl stop [a-zA-Z0-9@._-]*, /usr/bin/systemctl restart [a-zA-Z0-9@._-]*, /usr/bin/systemctl reload [a-zA-Z0-9@._-]*
agent-op ALL=(ALL) NOPASSWD: /usr/bin/systemctl status [a-zA-Z0-9@._-]*, /usr/bin/systemctl start [a-zA-Z0-9@._-]*, /usr/bin/systemctl stop [a-zA-Z0-9@._-]*, /usr/bin/systemctl restart [a-zA-Z0-9@._-]*, /usr/bin/systemctl reload [a-zA-Z0-9@._-]*
