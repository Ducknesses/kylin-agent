# agent-op sudoers - MCP Server 服务管理权限白名单
# 安装路径: /etc/sudoers.d/agent-op
# 权限: chmod 440, chown root:root
#
# mcp-server.service 以 agent-read 用户运行，service_mgr / sandbox 中的
# systemctl 变更操作（start/stop/restart/reload）通过 sudo -n 提权，
# 因此必须给 agent-read 授权；agent-op 保留给运维账号使用。
#
# 注意: sudoers 按命令完整路径匹配。若 `command -v systemctl` 的结果
# 不是 /usr/bin/systemctl（未做 usrmerge 的系统可能是 /bin/systemctl），
# 需相应调整下面的路径。

agent-read ALL=(root) NOPASSWD: /usr/bin/systemctl status *, /usr/bin/systemctl start *, /usr/bin/systemctl stop *, /usr/bin/systemctl restart *, /usr/bin/systemctl reload *
agent-op ALL=(ALL) NOPASSWD: /usr/bin/systemctl status *, /usr/bin/systemctl start *, /usr/bin/systemctl stop *, /usr/bin/systemctl restart *, /usr/bin/systemctl reload *
