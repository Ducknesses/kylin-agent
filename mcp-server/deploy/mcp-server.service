[Unit]
Description=MCP Server for Kylin OS Agent
Documentation=https://github.com/Ducknesses/kylin-agent
After=network.target
Wants=network.target

[Service]
Type=simple
User=agent-read
Group=agent-read
WorkingDirectory=/opt/mcp-server
ExecStart=/opt/mcp-server/venv/bin/python /opt/mcp-server/server.py
Restart=always
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-server
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/mcp-server
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=8001
Environment=LOG_FILE=/opt/mcp-server/mcp-server.log
Environment=METRICS_DB_PATH=/opt/mcp-server/metrics.db
EnvironmentFile=/opt/mcp-server/.env
# API_TOKEN 通过 EnvironmentFile 从 .env 注入，作为 python-dotenv 的 fallback

# 安全加固（兼容 systemd v249+）
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/mcp-server
ReadOnlyPaths=/proc /sys /dev
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
