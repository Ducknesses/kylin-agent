[Unit]
Description=Kylin Agent Backend
Documentation=https://github.com/Ducknesses/kylin-agent
After=network.target redis.service
Wants=network.target

[Service]
Type=simple
User=agent-read
Group=agent-read
WorkingDirectory=/opt/kylin-agent/backend
ExecStart=/opt/kylin-agent/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kylin-agent
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/kylin-agent/backend

# 安全加固
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/kylin-agent/backend/data
ReadOnlyPaths=/opt/kylin-agent/backend
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target