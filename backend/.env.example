# ============================================================
# DeepSeek Agent 后端环境变量模板
# 使用方法: cp .env.example .env 然后填写实际值
# .env 已被 .gitignore 排除，不会提交到 Git
# ============================================================

# ---------- LLM 统一配置 ----------
# 主开关：false 时所有 Agent 走规则版 fallback
LLM_ENABLED=false
# 提供商：deepseek | local_openai_compatible
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT=20
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ---------- DeepSeek API ----------
# 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- 本地模型预留 ----------
# 切换方式：LLM_PROVIDER=local_openai_compatible
# 使用 OpenAI-compatible /chat/completions 协议
LOCAL_LLM_ENABLED=false
LOCAL_LLM_PROVIDER=local_openai_compatible
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_API_KEY=

# ---------- MCP Server ----------
# MCP 模式：mock（默认，B 独立开发）/ real（对接执行器 C）
MCP_MODE=mock
MCP_SERVER_URL=http://127.0.0.1:18080
# MCP Server Bearer Token（生产环境必须配置）
MCP_AUTH_TOKEN=123456789

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- SQLite ----------
SQLITE_DB=./data/audit.db

# ---------- FastAPI ----------
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# ---------- Token 认证（空=不启用） ----------
# 单 token 模式：API_TOKEN=my-secret → 所有匹配均为 ADMIN
API_TOKEN=
# 多 token 分级模式（优先于 API_TOKEN）：API_TOKENS=read:rk_xxx,op:op_yyy,admin:adm_zzz
API_TOKENS=

# ---------- 运行时 ----------
COMMAND_TIMEOUT=30
MAX_INPUT_LENGTH=2000

# ---------- Mock/Real 模式切换 ----------
# true  → 走真实 DeepSeek + MCP 链路（需配置 DEEPSEEK_API_KEY + MCP_SERVER_URL）
# false → 走 Mock 编排器（关键词匹配，仅供前端联调，默认值）
USE_REAL_LLM=false

# ---------- 日志等级 ----------
LOG_LEVEL=INFO